{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "jest"],
    "skipLibCheck": true
  },
  "include": [
    "lecture/**/*",
    "lab/**/*",
    "homework/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
