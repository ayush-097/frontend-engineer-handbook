{
  "name": "performance-optimization",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode production",
    "build:analyze": "npm run build && webpack-bundle-analyzer dist/stats.json",
    "test": "vitest run",
    "test:perf": "vitest run tests/performance.test.ts",
    "test:bundle": "npm run build && node tests/bundle-size.test.js",
    "lighthouse": "lighthouse http://localhost:4173 --view"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "^1.0.9",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vite-plugin-bundle-analyzer": "^0.6.0",
    "vitest": "^1.4.0",
    "@testing-library/react": "^14.2.0",
    "gzip-size": "^7.0.0",
    "lighthouse": "^11.0.0",
    "webpack-bundle-analyzer": "^4.10.0"
  }
}
