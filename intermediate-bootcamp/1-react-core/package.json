{
  "name": "react-core",
  "version": "1.0.0",
  "description": "React Core — hooks, lifecycle, patterns, concurrent features",
  "type": "module",
  "scripts": {
    "dev":       "vite",
    "build":     "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "test:watch":"vitest",
    "test:ui":   "vitest --ui",
    "test:hooks":     "vitest run tests/hooks.test.tsx",
    "test:components":"vitest run tests/component-integration.test.tsx",
    "test:advanced":  "vitest run tests/custom-renderer.test.tsx"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-error-boundary": "^4.0.0",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^24.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0"
  }
}
